<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\Shared\sharedsettings.Production.json" Link="sharedsettings.Production.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Shared\sharedsettings.Development.json" Link="sharedsettings.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Shared\sharedsettings.qa.json" Link="sharedsettings.qa.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\Shared\log4net.Development.config" Link="log4net.Development.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Shared\log4net.qa.config" Link="log4net.qa.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\Shared\log4net.Production.config" Link="log4net.Production.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LSports.Extensions.Logging.Serilog" Version="5.0.0.5" />
    <PackageReference Include="LSports.Hosting.Http.Core" Version="3.1.0.50" />
    <PackageReference Include="LSports.Core.Common.Extensions" Version="3.1.0.16" />
    <PackageReference Include="LSports.Framework.Common.Utilities" Version="3.1.0.35" />
    <PackageReference Include="LSports.Legacy.Common.Entities" Version="3.1.1.184" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="7.0.4" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
    <PackageReference Include="Steeltoe.Extensions.Configuration.PlaceholderCore" Version="3.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LSports.DataMapping.Abstractions\LSports.DataMapping.Abstractions.csproj" />
    <ProjectReference Include="..\LSports.DataMapping.Services\LSports.DataMapping.Services.csproj" />
  </ItemGroup>

</Project>
