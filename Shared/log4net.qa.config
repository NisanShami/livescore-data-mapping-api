<log4net>
	<appender name="BufferingForwarder" type="log4net.Appender.BufferingForwardingAppender">
		<bufferSize value="512" />
		<lossy value="false" />
		<Fix value="268" />

		<evaluator type="log4net.Core.LevelEvaluator">
			<threshold value="INFO"/>
		</evaluator>
		<evaluator type="log4net.Core.TimeEvaluator">
			<interval value="15"/>
		</evaluator>

		<appender-ref ref="RollingFile" />
	</appender>

	<appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="Logs/%property{ServiceName}/%property{ServiceName}.log" />
		<appendToFile value="false"/>
		<rollingStyle value="Composite"/>
		<maxSizeRollBackups value="100"/>
		<maximumFileSize value="50MB"/>
		<staticLogFileName value="true"/>
		<datePattern value="yyyy-MM-dd"/>
		<preserveLogFileNameExtension value="true"/>
		<countDirection value="1"/>
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{ISO8601}] [%-5level] [%property{ServiceName}] [%logger{1}] [%2thread] %message%newline%exception"/>
		</layout>
	</appender>
	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date] [%thread] [%-5level] [%logger] - %message%newline" />
		</layout>
	</appender>
	<root>
		<level value="ALL" />
		<appender-ref ref="BufferingForwarder"/>
		<appender-ref ref="ConsoleAppender"/>
	</root>
</log4net>
