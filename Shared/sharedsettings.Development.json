    "RedshiftApiUrl": "https://di-history-viewer-realtime-api.dev-din.lsports-gcp.cloud/graphql",
    "RequestBody": "{{\"query\":\"query MyQuery {{ livescores(from_date: \\\"{0}\\\", fixture_ids: [{1}], skip: {2}, take: {3}) {{ message_guid fixture_id provider_id sequence_number period_type_id status timestamp payload }} }}\",\"variables\":null,\"operationName\":\"MyQuery\"}}"
  },
  "ConnectionStrings": {
    "Data": "server=${SECRET_DB_MYSQL_MAIN_HOST};UID=${SECRET_DB_MYSQL_MAIN_USERNAME};password=${SECRET_DB_MYSQL_MAIN_PASSWORD};database=data"
