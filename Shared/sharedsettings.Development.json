      "Password": "${SECRET_MESSAGE_BROKER_RMQ_OS_LSPORTSRUNNER_PASSWORD?${SECRET_MESSAGE_BROKER_RMQ_DIN_PASSWORD}}",
      "VHost": "TrackChanges"
    },
    {
      "Name": "Metadata",
      "Address": "${SECRET_MESSAGE_BROKER_RMQ_OS_ENDPOINT?${SECRET_MESSAGE_BROKER_RMQ_ENDPOINT}}",
      "Port": 5672,
      "User": "lsportsrunner",
      "Password": "${SECRET_MESSAGE_BROKER_RMQ_OS_LSPORTSRUNNER_PASSWORD?${SECRET_MESSAGE_BROKER_RMQ_DIN_PASSWORD}}",
      "VHost": "Metadata"
